#!/bin/bash
python3 -c '
import sys
if sys.version_info < (3, 11):
    sys.stderr.write("xay 需要 Python 3.11 或更新的版本，你现在是 %d.%d，请先升级（macOS：brew install python@3.11）\n" % (sys.version_info[0], sys.version_info[1]))
    sys.exit(2)
' || exit 2
# xay：命令入口。M5 起默认转给新版 V2（V2/bin/xay2）；只有旧版才有的子命令、旧系统派的活、或设了 XAY_V1=1 时走旧版（xay_cli.py）。
# 分发规则见 xay_switch.py；看一条命令会走哪边：xay --which <命令…>
HERE="$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")" && pwd)"
exec python3 "$HERE/xay_switch.py" "$@"
